shift + alt - 7 : ~/.config/scripts/sketchybar/space_focus.sh 7 move
shift + alt - 8 : ~/.config/scripts/sketchybar/space_focus.sh 8 move
shift + alt - 9 : ~/.config/scripts/sketchybar/space_focus.sh 9 move
shift + alt - 0 : ~/.config/scripts/sketchybar/space_focus.sh 10 move
alt - 1: ~/.config/scripts/sketchybar/space_focus.sh 1
alt - 2: ~/.config/scripts/sketchybar/space_focus.sh 2
alt - 3: ~/.config/scripts/sketchybar/space_focus.sh 3
