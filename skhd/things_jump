# / 跳转模式（things_nav.sh jump 系列动作）：按键直接由 skhd 捕获，不开输入框 ——
# 输入框是独立 app 的面板，从按下 / 到它拿到键盘焦点要 380ms，这段时间的按键会丢或漏给下层应用。
# 查询串显示在弹窗标题行上。由 skhdrc 的 .load 引入；模式内没绑定的键会漏给下层应用，
# 所以大小写字母、数字、空格、退格都要列全。

thingsjump < escape : ~/.config/scripts/things/things_nav.sh jumpcancel
thingsjump < return : ~/.config/scripts/things/things_nav.sh jumpaccept
thingsjump < backspace : ~/.config/scripts/things/things_nav.sh jumpkey BS
thingsjump < space : ~/.config/scripts/things/things_nav.sh jumpkey SP
thingsjump < down : ~/.config/scripts/things/things_nav.sh jumpmove down
thingsjump < up : ~/.config/scripts/things/things_nav.sh jumpmove up
thingsjump < ctrl - n : ~/.config/scripts/things/things_nav.sh jumpmove down
thingsjump < ctrl - p : ~/.config/scripts/things/things_nav.sh jumpmove up

